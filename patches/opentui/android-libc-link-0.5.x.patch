+/// Android is "linux" with an android ABI, not its own os tag.
+fn isAndroidTarget(target: std.Build.ResolvedTarget) bool {
+    return target.result.os.tag == .linux and
+        (target.result.abi == .android or target.result.abi == .androideabi);
+}
+
+/// Read an environment variable for Android build configuration.
+///
+/// Zig 0.16 removed std.process.getEnvVarOwned and std.posix has no getenv, so
+/// read through the build graph's environment map instead - the API std.Build
+/// itself uses for things like DESTDIR and PATH.
+fn androidEnv(b: *std.Build, key: []const u8) ?[]const u8 {
+    return b.graph.environ_map.get(key);
+}
+
+/// Expose the NDK sysroot bionic headers to @cImport. Zig cannot provision
+/// bionic itself, but the NDK's headers are a plain filesystem away.
+fn addAndroidBionicHeaders(b: *std.Build, module: *std.Build.Module) void {
+    const ndk_home = androidEnv(b, "ANDROID_NDK_HOME") orelse {
+        std.debug.print("WARNING: ANDROID_NDK_HOME not set; bionic libc headers unavailable\n", .{});
+        return;
+    };
+    const sysroot = b.pathJoin(&.{ ndk_home, "toolchains", "llvm", "prebuilt", "linux-x86_64", "sysroot" });
+    const triple = "aarch64-linux-android";
+    module.addSystemIncludePath(.{ .cwd_relative = b.pathJoin(&.{ sysroot, "usr", "include" }) });
+    module.addSystemIncludePath(.{ .cwd_relative = b.pathJoin(&.{ sysroot, "usr", "include", triple }) });
+}
+
+/// Same as addAndroidBionicHeaders but for translate-c steps, whose headers
+/// (miniaudio's pthread.h, yoga's math.h) need the bionic system includes too.
+fn addAndroidBionicHeadersToTranslate(b: *std.Build, step: *std.Build.Step.TranslateC) void {
+    const ndk_home = androidEnv(b, "ANDROID_NDK_HOME") orelse {
+        std.debug.print("WARNING: ANDROID_NDK_HOME not set; bionic libc headers unavailable\n", .{});
+        return;
+    };
+    const sysroot = b.pathJoin(&.{ ndk_home, "toolchains", "llvm", "prebuilt", "linux-x86_64", "sysroot" });
+    const triple = "aarch64-linux-android";
+    step.addSystemIncludePath(.{ .cwd_relative = b.pathJoin(&.{ sysroot, "usr", "include" }) });
+    step.addSystemIncludePath(.{ .cwd_relative = b.pathJoin(&.{ sysroot, "usr", "include", triple }) });
+    // bionic headers annotate parameters with _Nonnull/_Nullable/_Null_unspecified.
+    // In array-declarator position (e.g. 'const struct timeval __times[_Nullable 2]')
+    // the clang shipped inside Zig rejects the specifier on an array type:
+    //   error: nullability specifier cannot be applied to non-pointer type 'const struct timeval [2]'
+    // Strip them at the preprocessor so translate-c sees declarations without
+    // the annotations. clang has no effect from the macro value itself, and the
+    // lost annotations are irrelevant to @cImport() (Zig discards them anyway).
+    step.defineCMacro("_Nonnull", "");
+    step.defineCMacro("_Nullable", "");
+    step.defineCMacro("_Null_unspecified", "");
+}
+
+/// Path to the NDK's per-arch lib directory holding the libc.so API stubs and
+/// libc++_shared.so.
+fn androidArchLibDir(b: *std.Build, ndk_home: []const u8) []const u8 {
+    return b.pathJoin(&.{
+        ndk_home,
+        "toolchains",
+        "llvm",
+        "prebuilt",
+        "linux-x86_64",
+        "sysroot",
+        "usr",
+        "lib",
+        "aarch64-linux-android",
+    });
+}
+
+/// Give the shared library NEEDED entries for libc.so and libc++_shared.so.
+///
+/// The libc.so stub lives per-API-level (.../<api>/libc.so) while
+/// libc++_shared.so sits directly in the arch directory. Linking them as object
+/// files produces the NEEDED entries Android's linker needs without asking Zig
+/// to provision a bionic libc.
+fn linkAndroidStubs(b: *std.Build, lib: *std.Build.Step.Compile) void {
+    const ndk_home = androidEnv(b, "ANDROID_NDK_HOME") orelse {
+        std.debug.print("WARNING: ANDROID_NDK_HOME not set; cannot link bionic stubs\n", .{});
+        return;
+    };
+    const arch_lib = androidArchLibDir(b, ndk_home);
+    const api = androidEnv(b, "ANDROID_API") orelse "24";
+    const libc_stub = b.pathJoin(&.{ arch_lib, api, "libc.so" });
+    const libcpp = b.pathJoin(&.{ arch_lib, "libc++_shared.so" });
+    lib.root_module.addObjectFile(.{ .cwd_relative = libc_stub });
+    lib.root_module.addObjectFile(.{ .cwd_relative = libcpp });
+}
