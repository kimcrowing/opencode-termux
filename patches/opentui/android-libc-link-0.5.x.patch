+/// Link prebuilt yoga objects instead of compiling the C++ here.
+///
+/// Zig cannot cross-compile C++ against a bionic libc it cannot provision, so
+/// scripts/build-opentui.sh compiles the yoga C++ with the NDK's own clang++
+/// (which gets the bionic + libc++ include ordering right by construction). The
+/// resulting Foo.o files, one per Foo.cpp, live in OPENTUI_YOGA_OBJS_DIR.
+fn addAndroidYogaObjects(b: *std.Build, module: *std.Build.Module) void {
+    module.addIncludePath(b.dependency("yoga", .{}).path(""));
+    const objs_dir = androidEnv(b, "OPENTUI_YOGA_OBJS_DIR") orelse {
+        std.debug.print("WARNING: OPENTUI_YOGA_OBJS_DIR not set; yoga C++ will not be linked!\n", .{});
+        return;
+    };
+    for (YOGA_CXX_SOURCES) |src| {
+        const base = std.fs.path.basename(src);
+        const stem = base[0 .. base.len - 4]; // strip ".cpp"
+        module.addObjectFile(.{ .cwd_relative = b.pathJoin(&.{ objs_dir, b.fmt("{s}.o", .{stem}) }) });
+    }
+}
