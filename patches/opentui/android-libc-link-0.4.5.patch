-            artifact.linkSystemLibrary("dl");
-            artifact.linkSystemLibrary("pthread");
+            // Android (linux + android abi) uses bionic libc, which has no
+            // separate libdl/libpthread — they are merged into libc. Linking
+            // them explicitly makes Zig's paths_first search fail. Skip them.
+            if (target.result.abi != .android and target.result.abi != .androideabi) {
+                artifact.linkSystemLibrary("dl");
+                artifact.linkSystemLibrary("pthread");
+            }
         },
         else => {},
     }
 }
 
