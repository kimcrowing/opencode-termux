     artifact.addIncludePath(b.path("."));
-    artifact.linkLibC();
+
+    // Zig 0.15.2 does not ship an Android (bionic) libc, so linkLibC() fails
+    // with "unable to provide libc for target ...android". For Android we
+    // skip linkLibC and instead link the NDK's bionic libc.so/libraries in
+    // buildTarget (where the android-specific block lives).
+    const is_android = target.result.os.tag == .linux and
+        (target.result.abi == .android or target.result.abi == .androideabi);
+    if (!is_android) {
+        artifact.linkLibC();
+    }
+
     artifact.addCSourceFile(.{
         .file = b.path("miniaudio_shim.c"),
         .flags = c_flags,
@@ -162,8 +172,13 @@ fn addNativeAudioDependencies(
     switch (target.result.os.tag) {
         .macos => addMacOSSystemLibraries(b, artifact, macos_sdk_path.?),
         .linux => {
-            artifact.linkSystemLibrary("dl");
-            artifact.linkSystemLibrary("pthread");
+            // Android (linux + android abi) uses bionic libc, which has no
+            // separate libdl/libpthread — they are merged into libc. Linking
+            // them explicitly makes Zig's paths_first search fail. Skip them.
+            if (target.result.abi != .android and target.result.abi != .androideabi) {
+                artifact.linkSystemLibrary("dl");
+                artifact.linkSystemLibrary("pthread");
+            }
         },
