+// NVIDIA's OpenAI-compatible gateway (integrate.api.nvidia.com) strictly
+// validates request parameters and rejects `prompt_cache_key` with HTTP 400
+// ("Validation: Unsupported parameter(s): `prompt_cache_key`"). Providers that
+// accept the cache key (OpenAI, Azure, DeepSeek, Zai, ...) keep the current
+// behavior; gateways known to error out are excluded. Override per model with
+// `compatibility.supportsPromptCacheKey`.
+const detectSupportsPromptCacheKey = (provider: string, baseURL: string | undefined): boolean => {
+  const p = provider.toLowerCase()
+  const url = (baseURL ?? "").toLowerCase()
+  const isNvidia = p === "nvidia" || url.includes("integrate.api.nvidia.com")
+  return !isNvidia
+}
