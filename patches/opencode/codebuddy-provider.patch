+import type { IntegrationOAuthMethodRegistration } from "@opencode-ai/plugin/effect/integration"
+import { Effect } from "effect"
+import type { Form } from "@opencode-ai/schema/form"
+import { Credential } from "../../../../credential.js"
+import { Integration } from "../../../../integration.js"
+import type { DeviceFlowSpec } from "../types.js"
+
+async function postJSON(userAgent: string, url: string, body: unknown, signal: AbortSignal | undefined) {
+  const response = await fetch(url, {
+    method: "POST",
+    headers: {
+      Accept: "application/json",
+      "Content-Type": "application/json",
+      "User-Agent": userAgent,
+    },
+    body: JSON.stringify(body),
+    signal,
+  })
+  if (!response.ok) throw new Error(`Request failed: ${response.status}`)
+  return response.json() as Promise<any>
+}
+
+export function deviceOAuth(spec: DeviceFlowSpec, integrationID: string): IntegrationOAuthMethodRegistration {
+  const methodID = Integration.MethodID.make(spec.methodID ?? "device")
+  const margin = spec.pollingSafetyMarginMs ?? 3000
+  const resolveDomain = spec.loginDomain ?? (() => ({ domain: "github.com", enterprise: false }))
+  const oauthURLs = spec.oauthURLs ?? ((domain: string) => ({
+    device: `https://${domain}/login/device/code`,
+    token: `https://${domain}/login/oauth/access_token`,
+  }))
+  const baseUserURL = spec.userEndpoint ??
+    ((domain: string) => (domain === "github.com" ? "https://api.github.com" : `https://api.${domain}`) + "/copilot_internal/user")
+  const userHeaders = spec.userHeaders ?? ((token: string) => ({
+    Accept: "application/json",
+    Authorization: `Bearer ${token}`,
+  }))
+  const toCredential = spec.toCredential ?? ((ctx: { accessToken: string }) =>
+    Credential.OAuth.make({
+      type: "oauth",
+      methodID,
+      refresh: ctx.accessToken,
+      access: ctx.accessToken,
+      expires: 0,
+    }))
+
+  return {
+    integrationID: Integration.ID.make(spec.integrationID ?? integrationID),
+    method: {
+      id: methodID,
+      type: "oauth",
+      label: spec.label ?? "设备码登录",
+      ...(spec.form ? { form: spec.form } : {}),
+    },
+    authorize: (answer: Form.Answer) =>
+      Effect.gen(function* () {
+        const invalid = spec.validate?.(answer)
+        if (invalid) return yield* Effect.fail(new Error(invalid))
+        const { domain, enterprise } = resolveDomain(answer)
+        const urls = oauthURLs(domain)
+        const device = yield* Effect.tryPromise({
+          try: (signal) =>
+            postJSON(spec.userAgent(), urls.device, {
+              client_id: spec.clientId,
+              ...(spec.scope ? { scope: spec.scope } : {}),
+            }, signal),
+          catch: (cause) => cause as unknown,
+        })
+        const interval = Math.max(Number(device?.interval) || 1, 1) * 1000
+
+        const poll = (wait: number): Effect.Effect<Credential.OAuth, unknown> =>
+          Effect.tryPromise({
+            try: (signal) =>
+              postJSON(spec.userAgent(), urls.token, {
+                client_id: spec.clientId,
+                device_code: device?.device_code,
+                grant_type: "urn:ietf:params:oauth:grant-type:device_code",
+              }, signal),
+            catch: (cause) => cause as unknown,
+          }).pipe(
+            Effect.flatMap((token) => {
+              if (token?.access_token) {
+                const access = token.access_token
+                return Effect.tryPromise({
+                  try: async (signal) => {
+                    const response = await fetch(baseUserURL(domain, access), {
+                      headers: {
+                        ...userHeaders(access, domain),
+                        "User-Agent": spec.userAgent(),
+                      },
+                      signal,
+                    })
+                    if (!response.ok) throw new Error(`User request failed: ${response.status}`)
+                    return response.json() as Promise<Record<string, unknown>>
+                  },
+                  catch: (cause) => cause as unknown,
+                }).pipe(
+                  Effect.orElseSucceed(() => undefined),
+                  Effect.flatMap((user) => {
+                    const denied = user ? spec.requireEntitlement?.(user) : undefined
+                    if (denied) return Effect.fail(new Error(denied))
+                    return Effect.succeed(toCredential({ accessToken: access, domain, enterprise, user }))
+                  }),
+                )
+              }
+              if (token?.error === "authorization_pending") {
+                return Effect.sleep(wait + margin).pipe(Effect.andThen(poll(wait)))
+              }
+              if (token?.error === "slow_down") {
+                const next = token.interval && token.interval > 0 ? token.interval * 1000 : wait + 5000
+                return Effect.sleep(next + margin).pipe(Effect.andThen(poll(next)))
+              }
+              return Effect.fail(new Error(`Device authorization failed${token?.error ? `: ${token.error}` : ""}`))
+            }),
+          )
+
+        return {
+          mode: "auto" as const,
+          url: device?.verification_uri,
+          instructions: `Enter code: ${device?.user_code}`,
+          callback: poll(interval),
+        }
+      }),
+  }
+}
