+++ b/packages/core/src/plugin/provider/gateway/auth/ioa.ts
@@ -0,0 +1,192 @@
+import type { IntegrationOAuthMethodRegistration } from "@opencode-ai/plugin/effect/integration"
+import { Effect } from "effect"
+import { Credential } from "../../../../credential.js"
+import { Integration } from "../../../../integration.js"
+import { sleep } from "../util.js"
+
+export interface IOAOptions {
+  readonly platform?: string
+  readonly appVersion?: string
+  readonly ideName?: string
+  readonly ideType?: string
+  readonly ideVersion?: string
+  readonly product?: string
+  readonly agentIntent?: string
+  readonly envId?: string
+  readonly quiet?: boolean
+  readonly ttlMs?: number
+}
+
+export interface TokenData {
+  accessToken: string
+  refreshToken?: string
+  expiresIn?: number
+}
+
+const methodID = Integration.MethodID.make("ioa")
+const DEFAULT_TTL_MS = 10 * 60 * 1000
+
+function decodeJwtPayload(token: string) {
+  try {
+    const parts = token.split(".")
+    if (parts.length < 2) return null
+    const payload = parts[1].replace(/-/g, "+").replace(/_/g, "/")
+    const pad = "=".repeat((4 - (payload.length % 4)) % 4)
+    return JSON.parse(Buffer.from(payload + pad, "base64").toString("utf8")) as Record<string, any>
+  } catch {
+    return null
+  }
+}
+
+export function ioaResolveTenantId(accessToken: string) {
+  const p = decodeJwtPayload(accessToken)
+  if (!p) return ""
+  const iss = String(p.iss || "")
+  const m = iss.match(/realms\/sso-([^/]+)$/)
+  return p.tenant_id || p.tenantId || (m?.[1] || "")
+}
+
+export function ioaResolveEnterpriseId(accessToken: string) {
+  const p = decodeJwtPayload(accessToken)
+  if (!p) return ""
+  const roles = p.realm_access?.roles || p.resource_access?.account?.roles
+  if (roles) {
+    for (const r of roles) {
+      const m = String(r).match(/group-admin:([A-Za-z0-9-]+)/)
+      if (m?.[1]) return m[1]
+    }
+  }
+  return p.enterprise_id || p.enterpriseId || p.ent_id || p.entId || ""
+}
+
+export function ioaResolveUserId(accessToken: string) {
+  const p = decodeJwtPayload(accessToken)
+  return p?.user_id || p?.userId || p?.uid || p?.sub || ""
+}
+
+export function ioaAccountLabel(accessToken: string) {
+  const p = decodeJwtPayload(accessToken)
+  const phone = p?.preferred_username
+  if (phone) return String(phone)
+  const nick = p?.nickname || p?.name
+  if (nick) return String(nick)
+  return ioaResolveUserId(accessToken) || "未知账号"
+}
+
+function noAuthHeaders() {
+  return {
+    Accept: "application/json",
+    "Content-Type": "application/json",
+    "X-No-Authorization": "true",
+    "X-No-User-Id": "true",
+    "X-No-Enterprise-Id": "true",
+    "X-No-Department-Info": "true",
+  }
+}
+
+export async function ioaRequestAuthState(serverUrl: string, opts: IOAOptions) {
+  const platform = opts.platform ?? "VSCode"
+  const params = new URLSearchParams({ platform, ioa: "1" })
+  const response = await fetch(`${serverUrl}/v2/plugin/auth/state?${params.toString()}`, {
+    method: "POST",
+    headers: noAuthHeaders(),
+  })
+  if (!response.ok) throw new Error(`Auth state request failed: ${response.status}`)
+  const data: any = await response.json()
+  if (data.code !== 0 || !data.data?.state) throw new Error(`Invalid auth state response: ${JSON.stringify(data)}`)
+  const loginUrl = data.data.authUrl || `${serverUrl}/login?platform=${platform}&state=${data.data.state}&ioa=1`
+  return { state: data.data.state as string, url: loginUrl as string }
+}
+
+export async function ioaPollForToken(serverUrl: string, state: string, expiresAt: number) {
+  const headers = noAuthHeaders()
+  while (Date.now() < expiresAt) {
+    await sleep(3000)
+    try {
+      const response = await fetch(`${serverUrl}/v2/plugin/auth/token?state=${state}`, { headers })
+      if (response.ok) {
+        const data: any = await response.json()
+        if (data.code === 0 && data.data?.accessToken) return data.data as TokenData
+      }
+    } catch {}
+  }
+  return null
+}
+
+export async function ioaRefreshToken(serverUrl: string, refreshToken: string) {
+  try {
+    const response = await fetch(`${serverUrl}/v2/plugin/auth/token/refresh`, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        Accept: "application/json",
+        Authorization: `Bearer ${refreshToken}`,
+      },
+    })
+    if (!response.ok) return null
+    const data: any = await response.json()
+    if (data.code !== 0) return null
+    return (data.data || null) as TokenData | null
+  } catch {
+    return null
+  }
+}
+
+export function ioaCredFromToken(token: TokenData, current?: Credential.OAuth): Credential.OAuth {
+  const expires = token.expiresIn ? Date.now() + token.expiresIn * 1000 : Date.now() + 24 * 60 * 60 * 1000
+  const access = token.accessToken
+  return {
+    type: "oauth",
+    methodID,
+    access,
+    refresh: token.refreshToken || current?.refresh || "",
+    expires,
+    metadata: { uid: ioaResolveUserId(access) || current?.metadata?.uid || "" },
+  }
+}
+
+export function ioaOAuth(getServerUrl: () => string, integrationID: string, opts: IOAOptions = {}): IntegrationOAuthMethodRegistration {
+  return {
+    integrationID: Integration.ID.make(integrationID),
+    method: {
+      id: methodID,
+      type: "oauth",
+      label: "IOA 登录 (浏览器)",
+    },
+    authorize: () =>
+      Effect.gen(function* () {
+        const serverUrl = getServerUrl()
+        const authState = yield* Effect.tryPromise({
+          try: () => ioaRequestAuthState(serverUrl, opts),
+          catch: (cause) => cause as unknown,
+        })
+        const expiresAt = Date.now() + (opts.ttlMs ?? DEFAULT_TTL_MS)
+        return {
+          mode: "auto" as const,
+          url: authState.url,
+          instructions: "请在浏览器中完成 IOA 登录",
+          expiresAt,
+          callback: Effect.tryPromise({
+            try: () => ioaPollForToken(serverUrl, authState.state, expiresAt),
+            catch: (cause) => cause as unknown,
+          }).pipe(
+            Effect.flatMap((tokenData) =>
+              tokenData ? Effect.succeed(ioaCredFromToken(tokenData)) : Effect.fail(new Error("IOA 登录超时")),
+            ),
+          ),
+        }
+      }),
+    refresh: (credential) =>
+      Effect.tryPromise({
+        try: () => ioaRefreshToken(getServerUrl(), credential.refresh),
+        catch: (cause) => cause as unknown,
+      }).pipe(
+        Effect.flatMap((data) =>
+          data?.accessToken
+            ? Effect.succeed(ioaCredFromToken(data, credential))
+            : Effect.fail(new Error("IOA token refresh failed")),
+        ),
+      ),
+    label: (credential) => ioaAccountLabel(credential.access),
+  }
+}
