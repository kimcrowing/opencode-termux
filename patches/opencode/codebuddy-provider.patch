+import { Model } from "../../../model.js"
+import { Provider } from "../../../provider.js"
+import type { DiscoveryContext, ModelDescriptor, ModelSpec } from "./types.js"
+
+export interface DiscoveryResult {
+  readonly models: Map<Model.ID, Model.Info>
+  readonly reasoningIds: ReadonlySet<string>
+}
+
+export function formatCredits(credits?: string) {
+  const cr = credits
+  if (cr === undefined || cr === null || cr === "x0.00" || cr === "0.00") return { tag: "免费", free: true }
+  return { tag: `${String(cr).replace(/^x/i, "")} Credits/次`, free: false }
+}
+
+export function remoteToInfo(providerID: Provider.ID, m: ModelSpec): Model.Info {
+  const price = formatCredits(m.credits)
+  const baseName = m.name || m.id || m.model || "unknown"
+  const info = Model.Info.default(providerID, Model.ID.make(String(m.id)))
+  return {
+    ...info,
+    name: price.free ? `${baseName} · 免费` : `${baseName} · ${price.tag}`,
+    capabilities: {
+      tools: m.supportsToolCall !== false,
+      input: ["text", "image"],
+      output: ["text"],
+    },
+    limit: {
+      context: Math.max(m.maxInputTokens ?? 168000, 1),
+      output: Math.max(m.maxOutputTokens ?? 32000, 1),
+    },
+  }
+}
+
+export function modelSpecsToResult(providerID: Provider.ID, specs: readonly ModelSpec[]): DiscoveryResult {
+  const models = new Map(specs.map((m) => [Model.ID.make(String(m.id)), remoteToInfo(providerID, m)]))
+  const reasoningIds = new Set(
+    specs.filter((m) => m.reasoning || m.supportsReasoning).map((m) => String(m.id)),
+  )
+  return { models, reasoningIds }
+}
+
+export function seedSpecs(descriptor: ModelDescriptor): readonly ModelSpec[] {
+  if (descriptor.kind === "static") return descriptor.models
+  return descriptor.fallback ?? []
+}
+
+export function defaultResult(descriptor: ModelDescriptor, providerID: Provider.ID): DiscoveryResult {
+  return modelSpecsToResult(providerID, seedSpecs(descriptor))
+}
+
+function withTimeout<T>(promise: Promise<T>, ms: number): Promise<T> {
+  return Promise.race([
+    promise,
+    new Promise<never>((_, reject) => setTimeout(() => reject(new Error("timeout")), ms)),
+  ])
+}
+
+export async function discover(
+  descriptor: ModelDescriptor,
+  providerID: Provider.ID,
+  ctx: DiscoveryContext,
+  existing?: readonly Model.Info[],
+): Promise<DiscoveryResult | undefined> {
+  switch (descriptor.kind) {
+    case "static":
+      return defaultResult(descriptor, providerID)
+    case "discovery": {
+      const specs = await withTimeout(descriptor.fetch(ctx), descriptor.timeoutMs ?? 5000).catch(() => undefined)
+      if (specs && specs.length > 0) return modelSpecsToResult(providerID, specs)
+      return undefined
+    }
+    case "remote": {
+      const headers = descriptor.headers?.(ctx) ?? {}
+      const models = await withTimeout(
+        descriptor.load({ existing: existing ?? [], headers }),
+        5000,
+      ).catch(() => undefined)
+      if (!models || models.size === 0) return undefined
+      return { models, reasoningIds: new Set<string>() }
+    }
+  }
+}
