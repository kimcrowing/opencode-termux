@@ -0,0 +1,100 @@
+import type { BodyDescriptor } from "./types.js"
+
+export const DEFAULT_TOP_KEYS = Object.freeze([
+  "model", "messages", "stream", "max_tokens", "temperature",
+  "top_p", "top_k", "tools", "tool_choice", "stop", "n",
+  "presence_penalty", "frequency_penalty", "logit_bias",
+  "user", "response_format", "seed", "min_p",
+  "repetition_penalty", "stream_options",
+])
+
+export const DEFAULT_MSG_KEYS = Object.freeze([
+  "role", "content", "name", "tool_calls", "tool_call_id",
+  "function_call", "refusal",
+])
+
+export const DEFAULT_PART_TYPES = Object.freeze(["text", "image_url", "input_audio", "file"])
+
+export function mapEffortEffort(eff: unknown) {
+  if (eff == null) return null
+  const e = String(eff).toLowerCase()
+  if (e === "off" || e === "none") return null
+  if (e === "auto" || e === "default") return "high"
+  if (e === "max") return "xhigh"
+  if (["minimal", "low", "medium", "high", "xhigh"].includes(e)) return e
+  return "high"
+}
+
+export function resolveModel(input: string | undefined, descriptor: BodyDescriptor | undefined) {
+  if (descriptor?.defaultModel) return descriptor.defaultModel
+  let m = input || ""
+  if (descriptor?.stripModelPrefix) {
+    const slash = m.indexOf("/")
+    if (slash !== -1) m = m.slice(slash + 1)
+  }
+  return m
+}
+
+export function sanitizeRequestBody(req: any, descriptor: BodyDescriptor | undefined) {
+  const allowedTopKeys = new Set(descriptor?.allowedTopKeys ?? DEFAULT_TOP_KEYS)
+  const allowedMsgKeys = new Set(descriptor?.allowedMsgKeys ?? DEFAULT_MSG_KEYS)
+  const allowedPartTypes = new Set(descriptor?.allowedPartTypes ?? DEFAULT_PART_TYPES)
+  const out: Record<string, unknown> = {}
+  for (const k of Object.keys(req || {})) {
+    if (k === "baseURL" || k === "promptCacheKey") continue
+    if (allowedTopKeys.has(k)) out[k] = req[k]
+  }
+  const msgs: any[] = []
+  const seenToolCallIds = new Set<string>()
+  for (const raw of req.messages || []) {
+    if (!raw || typeof raw !== "object") continue
+    const m: Record<string, unknown> = {}
+    for (const k of Object.keys(raw)) {
+      if (k === "reasoning" || k === "reasoning_content") continue
+      if (allowedMsgKeys.has(k)) m[k] = (raw as Record<string, unknown>)[k]
+    }
+    const role = m.role
+    if (typeof m.content === "string") {
+    } else if (Array.isArray(m.content)) {
+      const parts = m.content
+        .filter((p: any) => p && p.type && allowedPartTypes.has(p.type))
+        .map((p: any) => (p.type === "text" ? { type: "text", text: p.text ?? "" } : p))
+      if (parts.length === 1 && parts[0].type === "text") m.content = parts[0].text
+      else m.content = parts
+    } else if (m.content == null) {
+      m.content = ""
+    } else {
+      m.content = String(m.content)
+    }
+    if (role === "assistant" && Array.isArray(m.tool_calls) && m.tool_calls.length) {
+      if (typeof m.content !== "string") m.content = m.content == null ? "" : String(m.content)
+    }
+    if (Array.isArray(m.tool_calls)) {
+      for (const tc of m.tool_calls) {
+        const f = tc.function || {}
+        let a = f.arguments
+        if (typeof a !== "string") {
+          try {
+            a = a == null ? "{}" : JSON.stringify(a)
+          } catch {
+            a = "{}"
+          }
+        } else {
+          try {
+            JSON.parse(a)
+          } catch {
+            a = "{}"
+          }
+        }
+        tc.function = Object.assign({}, f, { arguments: a })
+        if (tc.id) seenToolCallIds.add(tc.id)
+      }
+    }
+    msgs.push(m)
+  }
+  out.messages = msgs.filter((m) => m.role !== "tool" || seenToolCallIds.has(m.tool_call_id))
+  if (typeof out.tool_choice === "string" && !["auto", "none", "required"].includes(out.tool_choice)) {
+    out.tool_choice = { type: "function", function: { name: out.tool_choice } }
+  }
+  return out
+}
