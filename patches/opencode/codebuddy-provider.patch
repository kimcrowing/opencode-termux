+const encoder = new TextEncoder()
+
+function cleanDelta(delta: Record<string, unknown>) {
+  if (!delta || typeof delta !== "object") return delta
+  const out: Record<string, unknown> = {}
+  for (const [k, v] of Object.entries(delta)) {
+    if (v === null || v === undefined) continue
+    if ((k === "content" || k === "reasoning_content") && v === "") continue
+    if ((k === "refusal" || k === "extra_fields") && (v === "" || v === null)) continue
+    if (k === "tool_calls" && Array.isArray(v) && v.length === 0) continue
+    out[k] = v
+  }
+  return out
+}
+
+export function streamSanitized(response: Response): Response {
+  const upstream = response.body
+  if (!upstream) return response
+  const decoder = new TextDecoder()
+  const reader = upstream.getReader()
+  let buf = ""
+  let doneSeen = false
+
+  const stream = new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      const handleLine = (line: string) => {
+        if (!line.startsWith("data:")) return
+        const payload = line.slice(5).trim()
+        if (payload === "") return
+        if (payload === "[DONE]") {
+          doneSeen = true
+          controller.enqueue(encoder.encode("data: [DONE]\n\n"))
+          return
+        }
+        let obj: any
+        try {
+          obj = JSON.parse(payload)
+        } catch {
+          controller.enqueue(encoder.encode(`${line}\n\n`))
+          return
+        }
+        const choice = obj?.choices?.[0]
+        if (choice) {
+          if (choice.finish_reason === "") choice.finish_reason = null
+          if (choice.delta) choice.delta = cleanDelta(choice.delta)
+        }
+        controller.enqueue(encoder.encode(`data: ${JSON.stringify(obj)}\n\n`))
+      }
+      const { done, value } = await reader.read()
+      if (done) {
+        if (buf.trim() !== "")
+          for (const l of buf.split("\n"))
+            if (l.trim() !== "") handleLine(l)
+        buf = ""
+        if (!doneSeen) controller.enqueue(encoder.encode("data: [DONE]\n\n"))
+        controller.close()
+        return
+      }
+      buf += decoder.decode(value, { stream: true })
+      let idx
+      while ((idx = buf.indexOf("\n\n")) !== -1) {
+        const rawEvent = buf.slice(0, idx)
+        buf = buf.slice(idx + 2)
+        for (const line of rawEvent.split("\n")) {
+          if (line.trim() === "") continue
+          handleLine(line)
+        }
+      }
+    },
+    async cancel() {
+      try {
+        await reader.cancel()
+      } catch {}
+    },
+  })
+  return new Response(stream, { status: response.status, headers: response.headers })
+}
