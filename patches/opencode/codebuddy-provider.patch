+import { define, type Context } from "@opencode-ai/plugin/effect/plugin"
+import type { Entry } from "@opencode-ai/schema/config"
+import { Effect } from "effect"
+import { Config } from "../../config.js"
+import { ConfigEntryObserver } from "../../config/plugin/entry-observer.js"
+import { gatewayPluginEffect } from "./gateway/plugin.js"
+import type { AuthDescriptor, ChatDescriptor, GatewayProviderDescriptor, ModelDescriptor } from "./gateway/types.js"
+
+const defaultUserAgent = () => "opencode/gateway"
+
+interface GatewayInfo {
+  readonly type?: "gateway"
+  readonly name?: string
+  readonly gateway?: {
+    readonly baseURL?: string
+    readonly package?: string
+    readonly auth?: {
+      readonly kind?: "oauth2-device" | "bearer" | "apikey"
+      readonly clientId?: string
+      readonly scope?: string
+      readonly label?: string
+    }
+    readonly models?: {
+      readonly kind?: "static"
+      readonly models?: readonly { readonly id: string; readonly name?: string; readonly credits?: string }[]
+    }
+  }
+}
+
+function toDescriptor(id: string, info: GatewayInfo): GatewayProviderDescriptor {
+  const gateway = info.gateway
+  const auth: AuthDescriptor =
+    gateway?.auth?.kind === "oauth2-device"
+      ? {
+          kind: "oauth2-device",
+          integrationID: id,
+          clientId: gateway.auth.clientId ?? "",
+          scope: gateway.auth.scope,
+          label: gateway.auth.label,
+          userAgent: defaultUserAgent,
+        }
+      : gateway?.auth?.kind === "apikey"
+        ? { kind: "apikey" }
+        : { kind: "bearer" }
+  const chat: ChatDescriptor = {
+    baseURL: gateway?.baseURL ?? "",
+    chatPath: "/chat/completions",
+    auth: gateway?.auth?.kind === "apikey" ? { scheme: "x-api-key" } : { scheme: "bearer" },
+    body: {},
+  }
+  const models: ModelDescriptor = {
+    kind: "static",
+    models: (gateway?.models?.models ?? []).map((model) => ({
+      id: model.id,
+      name: model.name,
+      credits: model.credits,
+    })),
+  }
+  return {
+    id,
+    name: info.name ?? id,
+    integrationID: id,
+    basePath: "",
+    package: gateway?.package ?? "@ai-sdk/openai-compatible",
+    auth,
+    chat,
+    models,
+  }
+}
+
+export const GatewayConfigPlugin = define({
+  id: "opencode.provider.gateway.config",
+  effect: Effect.fn(function* (ctx: Context) {
+    const config = yield* Config.Service
+    const loaded = yield* ConfigEntryObserver.observe(config, ctx.event, ctx.catalog.reload())
+    for (const entry of loaded.entries) {
+      if (entry.type !== "document") continue
+      for (const [id, info] of Object.entries(entry.info.providers ?? {})) {
+        if (info.type !== "gateway" || !info.gateway) continue
+        yield* gatewayPluginEffect(toDescriptor(id, info))(ctx).pipe(Effect.orDie)
+      }
+    }
+  }),
+})
