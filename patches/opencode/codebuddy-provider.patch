+import { Effect, Semaphore, Stream } from "effect"
+import { Bus } from "../../../bus.js"
+import { Catalog } from "../../../catalog.js"
+import { Credential } from "../../../credential.js"
+import { Integration } from "../../../integration.js"
+import { KV } from "../../../kv.js"
+import { Model } from "../../../model.js"
+import { define, type Context } from "@opencode-ai/plugin/effect/plugin"
+import { Provider } from "../../../provider.js"
+import type { InternalPlugin, Requirements } from "../../internal.js"
+import { createGatewayFetch, type PipelineState } from "./pipeline.js"
+import { defaultResult, discover, type DiscoveryResult } from "./discovery.js"
+import { deviceOAuth } from "./auth/device.js"
+import { ioaOAuth } from "./auth/ioa.js"
+import type { AuthDescriptor, GatewayProviderDescriptor } from "./types.js"
+
+import type { IntegrationOAuthMethodRegistration } from "@opencode-ai/plugin/effect/integration"
+
+function buildRegistration(
+  d: GatewayProviderDescriptor,
+  getServerUrl: () => string,
+): IntegrationOAuthMethodRegistration | undefined {
+  const auth: AuthDescriptor = d.auth
+  switch (auth.kind) {
+    case "apikey":
+    case "bearer":
+      return undefined
+    case "oauth2-device":
+      return deviceOAuth(auth, d.id)
+    case "codebuddy-ioa":
+      return ioaOAuth(getServerUrl, d.integrationID ?? d.id, {
+        platform: auth.platform,
+        quiet: auth.quiet,
+        ttlMs: auth.ttlMs,
+      })
+    case "custom":
+      return auth.flow
+  }
+}
+
+function normalizeCredential(credential: any) {
+  if (!credential) return undefined
+  if (credential.type === "oauth") return credential
+  if (typeof credential.value === "string" && credential.value) {
+    return {
+      type: "oauth" as const,
+      access: credential.value,
+      refresh: credential.value,
+      expires: 0,
+      methodID: Integration.MethodID.make("key"),
+      metadata: {},
+    }
+  }
+  return undefined
+}
+
+export function createGatewayProvider(d: GatewayProviderDescriptor): InternalPlugin {
+  return define({
+    id: `opencode.provider.${d.id}`,
+    effect: (ctx) => gatewayPluginEffect(d)(ctx),
+  }) as unknown as InternalPlugin
+}
+
+export function gatewayPluginEffect(d: GatewayProviderDescriptor) {
+  return Effect.fn(`${d.id}.effect`)(function* (ctx: Context) {
+      const providerID = Provider.ID.make(d.id)
+      const integrationID = Integration.ID.make(d.integrationID ?? d.id)
+      const packageId = d.package ?? "@ai-sdk/openai-compatible"
+      const basePath = d.basePath ?? "/v2"
+      const quiet = d.quiet !== false
+      const catalog = yield* Catalog.Service
+      const bus = yield* Bus.Service
+      const kv = yield* KV.Service
+      const semaphore = Semaphore.makeUnsafe(1)
+
+      const pluginContext = yield* Effect.context<Requirements>()
+      const runInPlugin = Effect.runPromiseWith(pluginContext)
+
+      let resolvedServerUrl = d.chat.baseURL
+      let resolvedDomain = d.chat.detectDomain?.(resolvedServerUrl) ?? ""
+
+      const pipelineState: PipelineState = { reasoningIds: new Set<string>(), freeExhaustedUntil: 0 }
+
+      const getActive = Effect.fn(`${d.id}.active`)(function* () {
+        const connection = yield* ctx.integration.connection.active(integrationID)
+        if (!connection) return undefined
+        const credential = yield* ctx.integration.connection
+          .resolve(connection)
+          .pipe(Effect.orElseSucceed(() => undefined))
+        return normalizeCredential(credential)
+      })
+
+      const loaded: { models?: Map<Model.ID, Model.Info> } = {}
+
+      const commit = (result: DiscoveryResult) => {
+        loaded.models = result.models
+        pipelineState.reasoningIds = result.reasoningIds
+      }
+
+      const load = Effect.fn(`${d.id}.load`)(function* () {
+        const active = yield* getActive()
+        if (!active?.access) {
+          loaded.models = undefined
+          pipelineState.reasoningIds = new Set<string>()
+          return
+        }
+        const result = yield* Effect.tryPromise({
+          try: () =>
+            discover(
+              d.models,
+              providerID,
+              { token: active.access, serverUrl: resolvedServerUrl, domain: resolvedDomain },
+              loaded.models ? [...loaded.models.values()] : undefined,
+            ),
+          catch: (cause) => cause as unknown,
+        }).pipe(
+          Effect.catch(() =>
+            Effect.logDebug(`failed to sync ${d.name} models`).pipe(Effect.as(undefined)),
+          ),
+        )
+        if (result) commit(result)
+      })
+
+      const refresh = () => semaphore.withPermit(load().pipe(Effect.andThen(ctx.catalog.reload())))
+      yield* refresh().pipe(Effect.forkScoped)
+
+      const maybeCheckin = d.extras?.checkin
+        ? () =>
+            Effect.tryPromise({
+              try: () =>
+                d.extras!.checkin!({
+                  kv,
+                  getCredential: () => runInPlugin(getActive()),
+                  getServerUrl: () => resolvedServerUrl,
+                  getDomain: () => resolvedDomain,
+                }),
+              catch: (cause) => cause as unknown,
+            })
+        : () => Effect.void
+      yield* maybeCheckin().pipe(Effect.forkScoped)
+
+      const oauthRegistration = buildRegistration(d, () => resolvedServerUrl)
+      yield* ctx.integration.transform((editor) => {
+        if (d.auth.kind !== "apikey" && d.auth.kind !== "bearer") {
+          editor.method.remove(integrationID, { type: "key" })
+        }
+        if (oauthRegistration) editor.method.update(oauthRegistration)
+      })
+
+      yield* ctx.catalog.transform((evt) => {
+        evt.provider.update(providerID, (provider) => {
+          provider.name = d.name
+          provider.package = Provider.aisdk(packageId)
+          provider.integrationID = integrationID
+          if (!provider.settings || typeof provider.settings.baseURL !== "string") {
+            provider.settings = Provider.mergeOverlay(provider.settings, { baseURL: `${resolvedServerUrl}${basePath}` })
+          }
+        })
+        const models = loaded.models ?? defaultResult(d.models, providerID).models
+        for (const [, model] of models) {
+          evt.model.update(providerID, model.id, (draft) => {
+            draft.name = model.name
+            draft.capabilities = {
+              ...model.capabilities,
+              input: [...model.capabilities.input],
+              output: [...model.capabilities.output],
+            }
+            draft.limit = { ...model.limit }
+          })
+        }
+      })
+
+      yield* bus.subscribe(Credential.Event.Switched).pipe(
+        Stream.filter((event) => event.data.integrationID === integrationID),
+        Stream.runForEach(() =>
+          Effect.gen(function* () {
+            yield* maybeCheckin()
+            yield* refresh().pipe(Effect.forkScoped)
+          }),
+        ),
+        Effect.forkScoped({ startImmediately: true }),
+      )
+
+      yield* ctx.aisdk.hook(
+        "sdk",
+        Effect.fn(function* (evt) {
+          if (evt.model.providerID !== providerID) return
+          if (!evt.package.includes(packageId)) return
+          if (typeof evt.options?.baseURL === "string" && evt.options.baseURL) {
+            try {
+              const u = new URL(evt.options.baseURL)
+              const hostOnly = `${u.protocol}//${u.host}`
+              resolvedServerUrl = hostOnly
+              const newDomain = d.chat.detectDomain?.(hostOnly)
+              if (newDomain) resolvedDomain = newDomain
+            } catch {}
+          }
+          evt.options.baseURL = `${resolvedServerUrl}${basePath}`
+          evt.options.fetch = createGatewayFetch({
+            chat: d.chat,
+            state: pipelineState,
+            getCredential: () => runInPlugin(getActive()),
+            getServerUrl: () => resolvedServerUrl,
+            getDomain: () => resolvedDomain,
+            log: (level, message) => {
+              if (!quiet) {
+                if (level === "error") console.error(`[${d.id}] ${message}`)
+                else console.log(`[${d.id}] ${message}`)
+              }
+            },
+          })
+        }),
+      )
+    })
+}
