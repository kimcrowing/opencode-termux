+++ b/packages/core/src/plugin/provider/gateway/pipeline.ts
@@ -0,0 +1,214 @@
+import { Credential } from "../../../credential.js"
+import type { ChatDescriptor, HeaderContext, QuotaDescriptor } from "./types.js"
+import { mapEffortEffort, resolveModel, sanitizeRequestBody } from "./body.js"
+import { streamSanitized } from "./sse.js"
+import { createIdFactory, sleep } from "./util.js"
+
+export interface PipelineState {
+  reasoningIds: ReadonlySet<string>
+  freeExhaustedUntil: number
+}
+
+export interface PipelineEnv {
+  readonly chat: ChatDescriptor
+  readonly state: PipelineState
+  readonly getCredential: () => Promise<Credential.OAuth | undefined>
+  readonly getServerUrl: () => string
+  readonly getDomain: () => string
+  readonly log?: (level: "info" | "error", message: string) => void
+}
+
+type Fetch = (input: Parameters<typeof fetch>[0], init?: RequestInit) => Promise<Response>
+
+function credentialToken(credential: Credential.OAuth, field: ChatDescriptor["auth"]["field"]) {
+  if (field === "refresh") return credential.refresh
+  if (field === "refresh-or-access") return credential.refresh || credential.access
+  return credential.access
+}
+
+function isQuotaExhausted(status: number, text: string, quota: QuotaDescriptor) {
+  if (quota.status429 !== false && status === 429) return true
+  if (!text) return false
+  const lower = text.toLowerCase()
+  if (quota.keywords?.some((h) => h && lower.includes(h))) return true
+  try {
+    const parsed = JSON.parse(text)
+    const candidates = [parsed?.error?.data?.code, parsed?.error?.code, parsed?.data?.code, parsed?.code]
+    if (candidates.some((c) => quota.codes?.includes(String(c)))) return true
+  } catch {}
+  return false
+}
+
+function isTransientErr(status: number, text: string) {
+  if (status === 0) return true
+  if (status >= 500) return true
+  if (status === 400 && /11133/.test(text || "")) return true
+  return false
+}
+
+type RunResult =
+  | { readonly ok: true; readonly response: Response }
+  | { readonly ok: false; readonly lastErr: { status: number; text: string }; readonly exhausted: boolean; readonly reset: number }
+
+export function createGatewayFetch(env: PipelineEnv): Fetch {
+  const chat = env.chat
+  const quota = chat.quota ?? {}
+  const retry = chat.retry ?? {}
+  const bodyDesc = chat.body
+  const authDesc = chat.auth
+  const maxAttempts = retry.maxAttempts ?? 3
+  const backoffMs = retry.backoffMs ?? 800
+  const transient = retry.transient ?? isTransientErr
+  const exhausted = (status: number, text: string) => isQuotaExhausted(status, text, quota)
+  const resetParse = quota.resetParse ?? (() => 0)
+  const cooldownMs = quota.cooldownMs ?? 30 * 60 * 1000
+  const chatPath = chat.chatPath ?? "/chat/completions"
+  const sanitizeSse = chat.sse?.sanitize ?? true
+  const info = (message: string) => env.log?.("info", message)
+  const error = (message: string) => env.log?.("error", message)
+
+  return async (input, init) => {
+    const urlStr = String(input)
+    if (!urlStr.includes(chatPath)) return fetch(input, init)
+
+    const serverUrl = env.getServerUrl()
+    const domain = env.getDomain()
+
+    let active: Credential.OAuth | undefined
+    try {
+      active = await env.getCredential()
+    } catch {}
+    if (!active?.access) throw new Error("缺少 access token，请重新登录")
+    let cur = active
+    const label = chat.label?.(cur.access) ?? String((cur.metadata as Record<string, unknown> | undefined)?.uid ?? "")
+
+    const bodyRaw = init?.body
+    if (!bodyRaw) {
+      return new Response(JSON.stringify({ error: "Missing request body" }), {
+        status: 400,
+        headers: { "Content-Type": "application/json" },
+      })
+    }
+    const openaiRequest = JSON.parse(typeof bodyRaw === "string" ? bodyRaw : await new Response(bodyRaw).text())
+    const resolvedModel = resolveModel(openaiRequest.model, bodyDesc)
+    if (!resolvedModel) throw new Error("未设置模型，请设置默认模型或在 OpenCode 选择模型")
+
+    const buildHeaders = (token: string, modelId: string) => {
+      const ids = createIdFactory()
+      const ctx: HeaderContext = { token, modelId, serverUrl, domain, ids }
+      return {
+        ...authDesc.static,
+        ...(authDesc.scheme === "bearer" ? { Authorization: `Bearer ${token}` } : { "X-Api-Key": token }),
+        ...authDesc.dynamic?.(ctx),
+      }
+    }
+
+    const prepareBody = (modelId: string) => {
+      const b = sanitizeRequestBody(openaiRequest, bodyDesc) as Record<string, unknown>
+      b.model = modelId
+      b.stream = openaiRequest.stream ?? true
+      const userEffort = openaiRequest.reasoning_effort ?? openaiRequest.reasoning?.effort ?? bodyDesc?.defaultReasoningEffort
+      const mappedEffort = (bodyDesc?.mapEffort ?? mapEffortEffort)(userEffort)
+      if (mappedEffort && (bodyDesc?.addReasoningEffort?.(modelId, env.state.reasoningIds) ?? false)) {
+        b.reasoning_effort = mappedEffort
+      }
+      bodyDesc?.extraBody?.(b, openaiRequest)
+      return b
+    }
+
+    const doRequest = (credential: Credential.OAuth, modelId: string) =>
+      fetch(`${serverUrl}${chatPath}`, {
+        method: "POST",
+        headers: buildHeaders(credentialToken(credential, authDesc.field), modelId),
+        body: JSON.stringify(prepareBody(modelId)),
+        signal: init?.signal,
+      })
+
+    const runOnModel = async (modelId: string): Promise<RunResult> => {
+      let lastErr = { status: 0, text: "" }
+      let resp: Response | null = null
+      let attempt = 0
+      while (attempt < maxAttempts) {
+        attempt++
+        try {
+          resp = await doRequest(cur, modelId)
+        } catch (e: any) {
+          lastErr = { status: 0, text: String(e?.message || e) }
+          error(`账号 ${label} 请求异常: ${lastErr.text}`)
+          if (attempt < maxAttempts && transient(0, lastErr.text)) {
+            await sleep(backoffMs * attempt)
+            continue
+          }
+          return { ok: false, lastErr, exhausted: false, reset: 0 }
+        }
+        if ((resp.status === 401 || resp.status === 403) && cur.refresh && chat.refresh) {
+          const refreshed = await chat.refresh({ serverUrl, refreshToken: cur.refresh, current: cur })
+          if (refreshed) {
+            cur = refreshed
+            try {
+              resp = await doRequest(cur, modelId)
+            } catch {
+              resp = new Response("{}", { status: 500 })
+            }
+          }
+        }
+        if (resp.ok) {
+          info(`使用账号 ${label} 完成请求`)
+          return { ok: true, response: resp }
+        }
+        const errText = await resp.text()
+        lastErr = { status: resp.status, text: errText }
+        error(`账号 ${label} 失败: ${resp.status} - ${errText}`)
+        if (exhausted(resp.status, errText)) {
+          return { ok: false, lastErr, exhausted: true, reset: resetParse(errText) }
+        }
+        if (transient(resp.status, errText)) {
+          if (attempt < maxAttempts) {
+            error(`账号 ${label} 瞬时错误，重试 (${attempt}/${maxAttempts})`)
+            await sleep(backoffMs * attempt)
+            continue
+          }
+        }
+        return { ok: false, lastErr, exhausted: false, reset: 0 }
+      }
+      return { ok: false, lastErr, exhausted: false, reset: 0 }
+    }
+
+    const requestedFree = quota.fallback ? resolvedModel in quota.fallback : false
+    const paidFallback = requestedFree ? (quota.fallback?.[resolvedModel] ?? null) : null
+    let startModel = resolvedModel
+    if (env.state.freeExhaustedUntil && Date.now() < env.state.freeExhaustedUntil) {
+      if (paidFallback) {
+        startModel = paidFallback
+        info(
+          `免费模型 ${resolvedModel} 仍在重置窗口(${new Date(env.state.freeExhaustedUntil).toLocaleString()})，使用计费模型 ${paidFallback}`,
+        )
+      }
+    } else if (env.state.freeExhaustedUntil) {
+      env.state.freeExhaustedUntil = 0
+    }
+
+    let result = await runOnModel(startModel)
+    if (!result.ok && paidFallback && result.exhausted && startModel !== paidFallback) {
+      env.state.freeExhaustedUntil = result.reset || Date.now() + cooldownMs
+      info(
+        `免费模型 ${resolvedModel} 额度耗尽，切换计费模型 ${paidFallback}（重置 ${new Date(env.state.freeExhaustedUntil).toLocaleString()}）`,
+      )
+      result = await runOnModel(paidFallback)
+    }
+
+    if (result.ok) {
+      try {
+        return sanitizeSse ? streamSanitized(result.response) : result.response
+      } catch {
+        return result.response
+      }
+    }
+
+    error("请求失败")
+    return new Response(result.lastErr.text || "请求失败", {
+      status: result.lastErr.status || 502,
+      headers: { "Content-Type": "application/json" },
+    })
+  }
+}
