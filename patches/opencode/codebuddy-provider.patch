+import { Effect } from "effect"
+import { Credential } from "../../../credential.js"
+import { KV } from "../../../kv.js"
+import { localDateString } from "./util.js"
+import type { CheckinContext } from "./types.js"
+
+const PATH_STATUS = "/v2/billing/meter/checkin-status"
+const PATH_ACTIVITY = "/v2/billing/meter/checkin-activity-status"
+const PATH_CLAIM = "/v2/billing/meter/daily-checkin"
+
+export interface CodebuddyCheckinConfig {
+  readonly baseURL: string
+  readonly enabled: boolean
+  readonly quiet: boolean
+  readonly uidOf: (token: string) => string
+  readonly enterpriseIdOf?: (token: string) => string
+}
+
+function isAlreadyCheckedIn(payload: any) {
+  if (!payload || typeof payload !== "object") return false
+  const code = payload.code
+  const msg = String(payload.message || payload.msg || "")
+  if (code === 10001 || msg.includes("已签到") || msg.includes("已经签到")) return true
+  const data = payload.data
+  if (data && typeof data === "object" && (data.today_checked_in || data.checked_in)) return true
+  return Boolean(payload.today_checked_in || payload.checked_in)
+}
+
+function buildCheckinHeaders(cfg: CodebuddyCheckinConfig, accessToken: string, domain: string) {
+  const headers: Record<string, string> = {
+    Authorization: `Bearer ${accessToken}`,
+    Accept: "application/json",
+    "Content-Type": "application/json",
+    "X-Domain": domain || "www.codebuddy.cn",
+    "User-Agent": "opencode-codebuddy-plugin",
+  }
+  const uid = cfg.uidOf(accessToken)
+  if (uid) headers["X-User-Id"] = uid
+  const ent = cfg.enterpriseIdOf?.(accessToken)
+  if (ent) {
+    headers["X-Enterprise-Id"] = ent
+    headers["X-Tenant-Id"] = ent
+  }
+  return headers
+}
+
+async function postCheckin(cfg: CodebuddyCheckinConfig, base: string, pathname: string, accessToken: string, domain: string) {
+  const resp = await fetch(`${base}${pathname}`, {
+    method: "POST",
+    headers: buildCheckinHeaders(cfg, accessToken, domain),
+    body: "{}",
+  })
+  let payload: any = null
+  try {
+    payload = await resp.json()
+  } catch {
+    payload = null
+  }
+  return { status: resp.status, payload }
+}
+
+const kvSet = (kv: KV.Interface, key: string, value: any) => Effect.runPromise(kv.set(key, value))
+const kvGet = (kv: KV.Interface, key: string) => Effect.runPromise(kv.get(key))
+
+async function attemptCheckin(cfg: CodebuddyCheckinConfig, ctx: CheckinContext, accessToken: string, uid: string) {
+  const base = getBase(cfg, ctx)
+  const domain = ctx.getDomain()
+  const isCredited = (data: any) =>
+    !!data &&
+    (data.today_checked_in === true ||
+      (typeof data.total_credits === "number" && data.total_credits > 0) ||
+      (data.today_credit && data.today_credit > 0))
+  const logCredits = (data: any) => {
+    if (!data) return ""
+    return ` (今日+${data.today_credit ?? 0} 累计${data.total_credits ?? 0})`
+  }
+  await kvSet(ctx.kv, `codebuddy.checkin.${uid}`, { lastAttempt: localDateString() })
+  try {
+    let activity: any = null
+    try {
+      const act = await postCheckin(cfg, base, PATH_ACTIVITY, accessToken, domain)
+      if (act.status >= 200 && act.status < 300 && act.payload?.data) activity = act.payload
+    } catch {}
+
+    if (activity && isCredited(activity.data)) {
+      await kvSet(ctx.kv, `codebuddy.checkin.${uid}`, { lastSuccess: localDateString() })
+      if (!cfg.quiet) console.log(`[codebuddy][checkin] 今日已签到${logCredits(activity.data)}`)
+      return
+    }
+
+    const claim = await postCheckin(cfg, base, PATH_CLAIM, accessToken, domain)
+    if (claim.status === 401 || claim.status === 403) {
+      await kvSet(ctx.kv, `codebuddy.checkin.${uid}`, { lastAttempt: localDateString(), lastError: `claim ${claim.status}` })
+      if (!cfg.quiet) console.log(`[codebuddy][checkin] skipped: token rejected (${claim.status})`)
+      return
+    }
+    let after: any = null
+    try {
+      const act2 = await postCheckin(cfg, base, PATH_ACTIVITY, accessToken, domain)
+      if (act2.status >= 200 && act2.status < 300 && act2.payload?.data) after = act2.payload.data
+    } catch {}
+
+    if (after && isCredited(after)) {
+      await kvSet(ctx.kv, `codebuddy.checkin.${uid}`, { lastSuccess: localDateString() })
+      if (!cfg.quiet) console.log(`[codebuddy][checkin] 签到成功${logCredits(after)}`)
+      return
+    }
+    if (isAlreadyCheckedIn(claim.payload)) {
+      await kvSet(ctx.kv, `codebuddy.checkin.${uid}`, { lastSuccess: localDateString() })
+      if (!cfg.quiet) console.log("[codebuddy][checkin] 今日已签到")
+      return
+    }
+
+    if (!activity) {
+      const st = await postCheckin(cfg, base, PATH_STATUS, accessToken, domain)
+      if (st.status === 401 || st.status === 403) {
+        await kvSet(ctx.kv, `codebuddy.checkin.${uid}`, { lastAttempt: localDateString(), lastError: `status ${st.status}` })
+        if (!cfg.quiet) console.log(`[codebuddy][checkin] skipped: token rejected (${st.status})`)
+        return
+      }
+      if (isAlreadyCheckedIn(st.payload)) {
+        await kvSet(ctx.kv, `codebuddy.checkin.${uid}`, { lastSuccess: localDateString() })
+        if (!cfg.quiet) console.log("[codebuddy][checkin] 今日已签到")
+        return
+      }
+    }
+
+    if (claim.payload && claim.payload.code === 0) {
+      const credit = claim.payload.data?.credit ?? claim.payload.data?.today_credit ?? claim.payload.data?.points
+      await kvSet(ctx.kv, `codebuddy.checkin.${uid}`, { lastSuccess: localDateString() })
+      if (!cfg.quiet) console.log(`[codebuddy][checkin] 签到成功${credit != null ? ` credit=${credit}` : ""}`)
+      return
+    }
+    const errMsg = claim.payload?.msg || claim.payload?.message || `http ${claim.status}`
+    await kvSet(ctx.kv, `codebuddy.checkin.${uid}`, { lastAttempt: localDateString(), lastError: String(errMsg) })
+    if (!cfg.quiet) console.log(`[codebuddy][checkin] 签到失败: ${errMsg}`)
+  } catch (e: any) {
+    await kvSet(ctx.kv, `codebuddy.checkin.${uid}`, { lastAttempt: localDateString(), lastError: String(e?.message || e) })
+    if (!cfg.quiet) console.log(`[codebuddy][checkin] error: ${e?.message || e}`)
+  }
+}
+
+function getBase(cfg: CodebuddyCheckinConfig, ctx: CheckinContext) {
+  return cfg.baseURL
+}
+
+interface CheckinState {
+  readonly lastSuccess?: string
+  readonly lastAttempt?: string
+  readonly lastError?: string
+}
+
+function stateOf(value: unknown): CheckinState {
+  return value && typeof value === "object" ? (value as CheckinState) : {}
+}
+
+export function createCodebuddyCheckin(cfg: CodebuddyCheckinConfig) {
+  return async (ctx: CheckinContext) => {
+    if (!cfg.enabled) return
+    const credential: Credential.OAuth | undefined = await ctx.getCredential()
+    if (!credential?.access) return
+    const today = localDateString()
+    const uid = String(credential.metadata?.uid || cfg.uidOf(credential.access) || "_anon")
+    const value = await kvGet(ctx.kv, `codebuddy.checkin.${uid}`).catch(() => undefined)
+    const state = stateOf(value)
+    if (state.lastSuccess === today || state.lastAttempt === today) return
+    await attemptCheckin(cfg, ctx, credential.access, uid)
+  }
+}
